<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● FitBlood"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Conoce tus números."
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Completa tus datos para calcular tu IMC y energía diaria."
                android:textSize="15sp"
                android:textColor="#555555"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Sexo biológico"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <Spinner
                android:id="@+id/spSexo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#F2F2F2"
                android:padding="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Edad (años)"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <EditText
                android:id="@+id/etEdad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#F2F2F2"
                android:hint="Ejemplo: 32"
                android:inputType="number"
                android:padding="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Peso (kg)"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <EditText
                android:id="@+id/etPeso"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#F2F2F2"
                android:hint="Ejemplo: 62"
                android:inputType="numberDecimal"
                android:padding="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Altura (cm)"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <EditText
                android:id="@+id/etEstatura"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#F2F2F2"
                android:hint="Ejemplo: 165"
                android:inputType="numberDecimal"
                android:padding="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Actividad física"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <Spinner
                android:id="@+id/spActividad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#F2F2F2"
                android:padding="10dp"/>

            <Button
                android:id="@+id/btnCalcularResultado"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:text="Calcular resultados"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF0000"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Tus resultados"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="#F4F4F4"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Índice de masa corporal"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/tvResultadoIMC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="IMC: --"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="18dp"
                    android:background="#DDDDDD"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Energía diaria estimada"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#39734B"/>

                <TextView
                    android:id="@+id/tvResultadoCalorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Calorías diarias: --"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Estimación para mantener tu peso con tu actividad actual."
                    android:textSize="13sp"
                    android:textColor="#555555"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:text="Estos resultados son orientativos y no reemplazan una valoración profesional."
                android:textSize="13sp"
                android:textColor="#666666"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:text="Volver al menú principal"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF0000"/>

</LinearLayout>

